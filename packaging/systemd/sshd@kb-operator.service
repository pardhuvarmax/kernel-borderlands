[Unit]
Description=Kernel Borderlands SSH Operator Console (dedicated sshd instance, port 2222)
After=network.target
DefaultDependencies=no

[Service]
Type=notify
ExecStart=/usr/sbin/sshd -D -f /etc/kb/sshd_kb-operator.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Auto-create and manage /run/sshd lifecycle on startup/reboot
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755

# Hardening, but NOT an empty capability set. The earlier "lock it down fully"
# (CapabilityBoundingSet= empty) was wrong: found on a real host once the port-2222
# conflict stopped hiding it, every connection died pre-auth with
#   sshd: fatal: chroot("/run/sshd"): Operation not permitted [preauth]
# because sshd's privilege separation chroots and switches users. The bounding set is
# the minimum for that model, nothing for binding ports (2222 is unprivileged):
#   CAP_SYS_CHROOT          privsep chroot to /run/sshd
#   CAP_SETUID CAP_SETGID   drop to the privsep user and to `operator` (incl. initgroups)
#   CAP_CHOWN               hand the allocated PTY to the user
#   CAP_KILL                end the session's processes (they run as another uid)
#   CAP_AUDIT_WRITE         audit record on login when sshd is built with audit support
# The PID file is disabled in the sshd config (PidFile none) because ProtectSystem=strict
# makes /run read-only; systemd already tracks the main PID (Type=notify, -D).
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
MemoryDenyWriteExecute=true
ProtectSystem=strict

# Expanded allowed write paths to include the newly mapped runtime space
ReadWritePaths=/run/kb /run/sshd
CapabilityBoundingSet=CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL CAP_AUDIT_WRITE

[Install]
WantedBy=multi-user.target