[Unit]
Description=Kernel Borderlands Operator Dashboard
After=kbd.service
Requires=kbd.service
DefaultDependencies=no

[Service]
Type=simple
# REAL as of this pass: kb-op/kb-tui was extended (axum + rust-embed) into
# a unified binary — the same compiled kb-tui binary, installed here as
# kbopd, embeds kb-dashboard's production build (npm run build's dist/)
# and serves it over HTTP when run without a controlling TTY (see
# kb-op/kb-tui/src/main.rs's is_terminal() check + run_headless(), and
# src/dash.rs for the embedded-asset server). The Makefile's `build`/
# `install` targets copy the compiled kb-tui binary to bin/kbopd and
# install it as /usr/local/bin/kbopd.
#
# ExecStart was previously /opt/kb/bin/kbopd --config /etc/kb/config.yaml
# — both wrong: /opt/kb/bin/ was a stale manual-test location, not where
# `make install` actually puts anything (/usr/local/bin/, matching every
# other unit in this directory), and kbopd parses no CLI arguments at all
# today (no clap/env::args() anywhere in main.rs), so --config was silently
# ignored. Running the stale /opt/kb/bin/kbopd directly reproduced a real
# crash (`Error: Os { code: 6, ... "No such device or address" }`) that
# the current, correctly-installed /usr/local/bin/kbopd does not have —
# confirmed by running both binaries directly, side by side.
ExecStart=/usr/local/bin/kbopd
Restart=always
RestartSec=5

# Full hardening: kbopd's real runtime need is a network listener
# (embedded dashboard server, src/dash.rs, hardcoded to 127.0.0.1:8082)
# plus spawning /usr/local/bin/mcp-server as a child — nothing privileged.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
MemoryDenyWriteExecute=true
ProtectSystem=strict
ReadWritePaths=/run/kb
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
